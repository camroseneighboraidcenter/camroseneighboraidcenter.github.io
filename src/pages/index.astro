---
import BaseLayout from "../components/layout/BaseLayout.astro";
import Header from "../components/layout/Header.astro";
import Footer from "../components/layout/Footer.astro";
import Hero from "../components/ui/Hero.astro";
import ContentBlock from "../components/ui/ContentBlock.astro";
import CardGrid from "../components/ui/CardGrid.astro";
import Card from "../components/ui/Card.astro";
import CallToAction from "../components/ui/CallToAction.astro";
import { getCollection, getEntry, type CollectionEntry } from "astro:content";
import type { PageData } from "../content.config";

type Program = CollectionEntry<"programs">;

const entry = await getEntry("pages", "home");
if (!entry || entry.data.page !== "home") {
  throw new Error("Missing or invalid src/content/pages/home.yaml");
}
const page = entry.data as Extract<PageData, { page: "home" }>;

const allPrograms = await getCollection("programs");
const featuredPrograms = allPrograms
  .filter((p: Program) => p.data.featured)
  .sort((a: Program, b: Program) => a.data.order - b.data.order);
---

<BaseLayout title="Home" description={page.description}>
  <Header slot="header" />

  <div class="home-content">
    <Hero
      title={page.hero.title}
      backgroundImage={page.hero.image}
      ctaText={page.hero.ctaText}
      ctaLink={page.hero.ctaLink}
    />

    <section class="mission-section">
      <ContentBlock
        title={page.whoWeAre.title}
        content={page.whoWeAre.content}
        variant="highlight"
      >
        <p class="motto-intro">{page.whoWeAre.mottoIntro}</p>
        <p class="motto">{page.whoWeAre.motto}</p>
      </ContentBlock>
      <ContentBlock
        title={page.mission.title}
        content={page.mission.content}
        variant="card"
      />
    </section>

    <CardGrid
      title={page.featured.title}
      subtitle={page.featured.subtitle}
      variant="featured"
    >
      {featuredPrograms.map((program: Program) => (
        <li>
          <Card
            title={program.data.title}
            description={program.data.description}
            image={program.data.image}
            imageAlt={program.data.imageAlt}
            href={`/programs/${program.id}`}
          />
        </li>
      ))}
    </CardGrid>

    <CallToAction
      title={page.cta.title}
      description={page.cta.description}
      primaryCta={page.cta.primaryCta}
      secondaryCta={page.cta.secondaryCta}
    />
  </div>

  <Footer slot="footer" />
</BaseLayout>

<style>
  .home-content {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
  }

  .mission-section {
    padding: 0 var(--container-padding);
    max-width: var(--container-max-width);
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
  }

  .motto-intro {
    font-size: var(--text-lg);
    color: var(--color-text);
    margin-top: var(--space-4);
  }

  .motto {
    font-size: var(--text-xl);
    font-weight: 600;
    color: var(--color-link);
    margin-top: var(--space-2);
  }

  @media (width <= 768px) {
    .home-content {
      gap: var(--space-6);
    }

    .mission-section {
      padding: 0 var(--container-padding);
    }
  }
</style>
