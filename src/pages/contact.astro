---
import BaseLayout from "../components/layout/BaseLayout.astro";
import Header from "../components/layout/Header.astro";
import Footer from "../components/layout/Footer.astro";
import Hero from "../components/ui/Hero.astro";
import ContactForm from "../components/ui/ContactForm.astro";
import ContactInfo from "../components/ui/ContactInfo.astro";
import CallToAction from "../components/ui/CallToAction.astro";
import { getEntry } from "astro:content";
import { getSite } from "../utils/site";
import type { PageData } from "../content.config";

const entry = await getEntry("pages", "contact");
if (!entry || entry.data.page !== "contact") {
  throw new Error("Missing or invalid src/content/pages/contact.yaml");
}
const page = entry.data as Extract<PageData, { page: "contact" }>;

const site = await getSite();
const { address } = site.contact;
const mapQuery = encodeURIComponent(
  `${address.street} ${address.city}, ${address.province}`,
);
const mapLabel = `${address.street}, ${address.city}, ${address.province}`;
---

<BaseLayout title="Contact Us" description={page.description}>
  <Header slot="header" />

  <div class="contact-content">
    <Hero
      title={page.hero.title}
      backgroundImage={page.hero.image}
      ctaText={page.hero.ctaText}
      ctaLink={page.hero.ctaLink}
    />

    <div class="contact-grid">
      <ContactForm />
      <ContactInfo />
    </div>

    <section id="location" class="map-section" aria-labelledby="map-title">
      <h2 id="map-title" class="sr-only">
        Our Location
      </h2>
      <div class="map-container">
        <iframe
          title={`Map showing Camrose Neighbor Aid Center at ${mapLabel}`}
          src={`https://maps.google.com/maps?;hl=en&q=${mapQuery}&t=&z=15&ie=UTF8&iwloc=B&output=embed`}
          allowfullscreen
          loading="lazy"
        ></iframe>
        <a
          class="sr-only"
          href={`https://maps.google.com/?q=${mapQuery}`}
          target="_blank"
          rel="noopener noreferrer"
        >
          Open Camrose Neighbor Aid Center location in Google Maps
        </a>
      </div>
    </section>

    <CallToAction
      title={page.cta.title}
      description={page.cta.description}
      primaryCta={page.cta.primaryCta}
      secondaryCta={page.cta.secondaryCta}
    />
  </div>

  <Footer slot="footer" />
</BaseLayout>

<style>
  .contact-content {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
  }

  .contact-grid {
    width: 100%;
    max-width: 1400px;
    display: flex;
    flex-direction: row;
    justify-content: space-around;
    align-items: flex-start;
    gap: var(--space-4);
    margin: 0 auto;
    padding: 0 var(--space-2);
  }

  .map-section {
    width: 100%;
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 var(--space-4);
  }

  .map-container {
    position: relative;
    width: 100%;
    height: 450px;
    border-radius: var(--radius-lg);
    overflow: hidden;
  }

  .map-container iframe {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }

  .social-links-contact {
    justify-content: start;
  }

  @media (width <= 768px) {
    .contact-content {
      gap: var(--space-6);
    }

    .contact-grid {
      flex-direction: column;
      align-items: stretch;
      gap: var(--space-6);
    }
  }
</style>
