---
import { Image } from "astro:assets";
import logo from "../assets/NA-Logo.png";
import BaseLayout from "../components/layout/BaseLayout.astro";
import Header from "../components/layout/Header.astro";
import Footer from "../components/layout/Footer.astro";
import Hero from "../components/ui/Hero.astro";
import ContentBlock from "../components/ui/ContentBlock.astro";
import FeatureGrid from "../components/ui/FeatureGrid.astro";
import CallToAction from "../components/ui/CallToAction.astro";
import TeamGrid from "../components/ui/TeamGrid.astro";
import { getCollection, getEntry, type CollectionEntry } from "astro:content";
import type { PageData } from "../content.config";

const entry = await getEntry("pages", "about");
if (!entry || entry.data.page !== "about") {
  throw new Error("Missing or invalid src/content/pages/about.yaml");
}
const page = entry.data as Extract<PageData, { page: "about" }>;

const team = await getCollection("team");
const membersByGroup = (group: "directors" | "staff") =>
  team
    .filter((m: CollectionEntry<"team">) => m.data.group === group)
    .sort(
      (a: CollectionEntry<"team">, b: CollectionEntry<"team">) =>
        a.data.order - b.data.order,
    )
    .map((m: CollectionEntry<"team">) => m.data);
const directors = membersByGroup("directors");
const staff = membersByGroup("staff");
---

<BaseLayout title="About Us" description={page.description}>
  <Header slot="header" />

  <div class="about-page">
    <Hero
      title={page.hero.title}
      backgroundImage={page.hero.image}
      ctaText={page.hero.ctaText}
      ctaLink={page.hero.ctaLink}
    />
    <div class="content-wrapper">
      <section class="intro-section">
        <div class="content-container">
          <p class="lead-text">{page.intro}</p>
        </div>
      </section>

      <ContentBlock
        title={page.vision.title}
        content={page.vision.content}
        variant="banner"
      />

      <section class="logo-container">
        <h2 class="sr-only">Our Logo</h2>
        <Image
          src={logo}
          alt="Camrose Neighbor Aid Center Logo - Hands linked in Christ's name to meet the needs of others"
          width={800}
          height={320}
          quality={90}
          class="logo-image"
          loading="lazy"
        />
      </section>

      <FeatureGrid title={page.values.title} items={page.values.items} />
      <ContentBlock
        title={page.beliefs.title}
        content={page.beliefs.items}
        variant="banner"
      />
      <TeamGrid title={page.teamHeadings.directors} members={directors} />
      <TeamGrid title={page.teamHeadings.staff} members={staff} />

      <CallToAction
        title={page.cta.title}
        description={page.cta.description}
        primaryCta={page.cta.primaryCta}
        secondaryCta={page.cta.secondaryCta}
      />
    </div>
  </div>

  <Footer slot="footer" />
</BaseLayout>

<style>
  .about-page {
    display: flex;
    flex-direction: column;
    min-height: 100vh;
    gap: var(--space-4);
  }

  .content-wrapper {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding: var(--space-8) 0;
  }

  .content-container {
    max-width: var(--container-max-width);
    margin: var(--space-8) auto;
    padding: 0 var(--container-padding);
    width: 100%;
  }

  .intro-section {
    text-align: center;
    margin-bottom: var(--space-8);
  }

  /* Logo section styles */
  .logo-container {
    display: flex;
    justify-content: center;
    align-items: center;
    margin: var(--space-8) auto;
    max-width: min(var(--max-width-4xl), 80vw);
    padding: 0 var(--container-padding);
  }

  .logo-image {
    width: 100%;
    height: auto;
    object-fit: contain;
    transition: transform var(--transition-normal);
  }

  /* Enhance logo on hover/focus for interactive feedback */
  .logo-image:hover,
  .logo-image:focus-visible {
    transform: scale(1.05);
  }

  /* Respect user's reduced motion preference */
  @media (prefers-reduced-motion: reduce) {
    .logo-image {
      transition: none;
    }

    .logo-image:hover,
    .logo-image:focus-visible {
      transform: none;
    }
  }

  .lead-text {
    font-size: var(--text-xl);
    color: var(--color-text-light);
    max-width: 80ch;
    margin: 0 auto;
    line-height: 1.6;
    text-align: justify;
  }

  .section-title {
    font-size: var(--text-3xl);
    font-weight: 700;
    color: var(--color-text-heading);
    margin-bottom: var(--space-8);
    text-align: center;
  }

  .section-description {
    text-align: center;
    color: var(--color-text-light);
    margin-bottom: var(--space-8);
  }

  @media (width <= 768px) {
    .content-wrapper {
      gap: var(--space-12);
      padding: var(--space-12) 0;
    }

    .lead-text {
      font-size: var(--text-lg);
    }

    .section-title {
      font-size: var(--text-2xl);
    }
  }
</style>
