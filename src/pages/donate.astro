---
import BaseLayout from "../components/layout/BaseLayout.astro";
import Header from "../components/layout/Header.astro";
import Footer from "../components/layout/Footer.astro";
import Hero from "../components/ui/Hero.astro";
import FeatureGrid from "../components/ui/FeatureGrid.astro";
import CallToAction from "../components/ui/CallToAction.astro";
import { getEntry } from "astro:content";
import { getSite } from "../utils/site";
import {
  renderMarkdown,
  renderMarkdownInline,
  siteVars,
} from "../utils/markdown";
import type { PageData } from "../content.config";

const entry = await getEntry("pages", "donate");
if (!entry || entry.data.page !== "donate") {
  throw new Error("Missing or invalid src/content/pages/donate.yaml");
}
const page = entry.data as Extract<PageData, { page: "donate" }>;

const site = await getSite();
const vars = siteVars(site);

const methodItems = page.methods.items.map((item) => ({
  title: item.title,
  descriptionHtml: renderMarkdownInline(item.body, vars),
}));
---

<BaseLayout title="Donate" description={page.description}>
  <Header slot="header" />

  <div class="donate-page">
    <Hero
      title={page.hero.title}
      backgroundImage={page.hero.image}
      ctaText={page.hero.ctaText}
      ctaLink={page.hero.ctaLink}
    />
    <div class="content-wrapper">
      <section class="intro-section">
        <div class="content-container flex-col">
          <div class="lead-text" set:html={renderMarkdown(page.intro, vars)} />
          <p class="donation-methods">{page.methodsIntro}</p>
        </div>
      </section>
      <section id="ways-to-donate">
        <FeatureGrid title={page.methods.title} items={methodItems} />
      </section>
      <CallToAction
        title={page.cta.title}
        description={page.cta.description}
        primaryCta={page.cta.primaryCta}
        secondaryCta={page.cta.secondaryCta}
      />
    </div>
  </div>

  <Footer slot="footer" />
</BaseLayout>

<style>
  .donate-page {
    display: flex;
    flex-direction: column;
    min-height: 100vh;
    gap: var(--space-4);
  }

  .content-wrapper {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding: var(--space-8) 0;
  }

  .content-container {
    max-width: var(--max-width-7xl);
    margin: var(--space-8) auto;
    padding: 0 var(--space-4);
    width: 100%;
  }

  .intro-section {
    text-align: center;
    margin-bottom: var(--space-8);
  }

  .lead-text,
  .donation-methods {
    font-size: var(--text-xl);
    color: var(--color-text-light);
    max-width: 80ch;
    margin: var(--space-8) auto;
    line-height: 1.7;
    text-align: justify;
  }

  .lead-text p {
    margin: 0;
  }

  .lead-text p + p {
    margin-top: var(--space-4);
  }

  .lead-text a {
    color: var(--color-link);
    text-decoration: underline;
    font-weight: 600;
  }

  .lead-text a:hover,
  .lead-text a:focus-visible {
    color: var(--color-link-hover);
  }

  .section-title {
    font-size: var(--text-3xl);
    font-weight: 700;
    color: var(--color-text-heading);
    margin-bottom: var(--space-8);
    text-align: center;
  }

  .section-description {
    text-align: center;
    color: var(--color-text-light);
    margin-bottom: var(--space-8);
  }

  @media (width <= 768px) {
    .content-wrapper {
      gap: var(--space-12);
      padding: var(--space-12) 0;
    }

    .lead-text,
    .donation-methods {
      font-size: var(--text-lg);
    }

    .section-title {
      font-size: var(--text-2xl);
    }
  }
</style>
