{
  "private": true,
  "type": "module",
  "name": "camroseneighboraidcenter.ca",
  "description": "Camrose Neighbor Aid Center website",
  "version": "0.0.1",
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "lint": "prettier --check . && astro check && eslint \"src/**/*.{js,jsx,ts,tsx,astro}\" && stylelint \"**/*.{css,astro}\" --report-needless-disables --report-invalid-scope-disables && markdownlint \"**/*.md\" \"**/*.mdx\"",
    "fix": "prettier --write . && astro check && eslint --fix \"src/**/*.{js,jsx,ts,tsx,astro}\" && stylelint \"**/*.{css,astro}\" --fix --report-needless-disables --report-invalid-scope-disables && markdownlint --fix \"**/*.md\" \"**/*.mdx\"",
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "knip": "knip",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "astro": "^7.3.5",
    "markdown-it": "^15.0.2",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@eslint/js": "^10.0.1",
    "@types/markdown-it": "^14.2.0",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-astro": "^3.2.1",
    "knip": "^6.39.0",
    "markdownlint-cli": "^0.49.1",
    "postcss-html": "^2.0.0",
    "prettier": "^3.9.9",
    "prettier-plugin-astro": "^1.1.0",
    "stylelint": "^17.16.0",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0"
  }
}
